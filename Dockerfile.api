FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DEFAULT_TIMEOUT=1000 \
    PIP_RETRIES=5

WORKDIR /app

# Install curl for healthcheck (force IPv4 to avoid Debian mirror IPv6 timeouts)
RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 \
    && apt-get update && apt-get install -y --no-install-recommends \
       curl \
    && rm -rf /var/lib/apt/lists/*

# 1. Install Python 3.10-compatible CPU-only PyTorch from official PyTorch CPU wheel index
RUN pip install --no-cache-dir \
    --default-timeout=1000 \
    --retries 5 \
    torch \
    --extra-index-url https://download.pytorch.org/whl/cpu

# 2. Install API & RAG dependencies while preserving CPU-only PyTorch (no NVIDIA/CUDA packages)
COPY requirements-api.txt .
RUN pip install --no-cache-dir \
    --default-timeout=1000 \
    --retries 5 \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements-api.txt

# 3. Copy application source
COPY . .

# Expose FastAPI port
EXPOSE 8000

# Default command: Runs the FastAPI backend via Gunicorn + Uvicorn worker
CMD ["gunicorn", "app.api.main:app", "--workers", "4", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000"]
